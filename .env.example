# Cluster configuration lives in clusters.json (required). Copy clusters.example.json
# to clusters.json and fill in your clusters; docker-compose mounts ./clusters.json
# into the container read-only.

# Per-cluster fields:
#   id                    - name MCP clients pass to the tools
#   url                   - https://host:8006 (the /api2/json suffix is optional)
#   token                 - Proxmox API token, "user@realm!name=uuid"

# API key for authenticating MCP requests (Bearer token). Empty disables auth.
MCP_SERVER_API_KEY=

# Set to 1 (or true/yes) to unregister the snapshot and backup tools at startup;
# the server then exposes only the read tools and never sends a write request.
# Any other value (including empty) keeps them enabled. Read once at startup.
SAFEPROX_DISABLE_WRITE_TOOLS=
